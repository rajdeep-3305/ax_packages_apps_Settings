    <!-- About Bonding Modes Explainer -->
    <string name="netbond_mode_info_title">About bonding modes</string>
    <string name="netbond_mode_info_summary">Learn which mode to choose for gaming, downloads, or saving data</string>
    <string name="netbond_mode_info_dialog_title">About Bonding Modes</string>
    <string name="netbond_mode_turbo_desc">Combines Wi-Fi and mobile data proportionally for peak bandwidth.\nBest for: Downloads, updates, and cloud backups.</string>
    <string name="netbond_mode_adaptive_desc">Steers latency-sensitive packets to the lowest-ping link while bonding bulk traffic.\nBest for: Online gaming, voice calls, and VoIP.</string>
    <string name="netbond_mode_saver_desc">Prefers Wi-Fi to save cellular data, engaging mobile data seamlessly if Wi-Fi drops.\nBest for: Limited data plans.</string>
    <string name="netbond_mode_split_desc">Distributes new connections 50/50 across both networks.\nBest for: Links with similar speeds and latency.</string>
    <string name="netbond_mode_info_disclaimer">Actual speeds depend on your Wi-Fi, mobile carrier, and app behavior. Single-connection transfers cannot exceed one link\'s speed, so try different modes to see what works best on your networks.</string>
    <string name="netbond_got_it">Got it</string>

